@startuml
' Component diagram for sirius-skills src/
package "sirius_skills" {
  [CLI] as CLI
  package "commands" {
    [Commands Modules] as Commands
  }
  package "lib" {
    [workflow_runtime] as Runtime
    [workflow_state] as State
  }
  [paths] as Paths
}

CLI --> Paths : uses
CLI --> Commands : invokes
Commands --> State : read/write planning data
Commands --> Runtime : use runtime helpers
Runtime --> State : persist/read state

@enduml
